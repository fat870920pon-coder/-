#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR" || exit 1

echo "=========================================================="
echo "🚀 正在啟動【月下餐飲集團 - 財務對帳看板即時伺服器】..."
echo "=========================================================="
echo "💡 提示：開啟看板後，點擊網頁右上角的【即時更新】"
echo "   系統會自動重新抓取 Google 試算表最新數據並將時間更新為當下！"
echo "   若要關閉伺服器，直接關閉此視窗或按 Ctrl+C 即可。"
echo "=========================================================="

# 延遲 1 秒自動開啟預設瀏覽器
(sleep 1 && open "http://localhost:8080") &

# 啟動 Python 即時後端服務
./venv/bin/python3 server.py

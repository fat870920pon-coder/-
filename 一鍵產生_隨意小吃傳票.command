#!/usr/bin/env bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

echo "================================================================="
echo "   隨意小吃 ➔ 文中會計系統傳票一鍵產生工具"
echo "================================================================="
echo ""

./run.sh --store 隨意小吃 "$@"

echo ""
read -p "請按 Enter 鍵關閉此視窗..."

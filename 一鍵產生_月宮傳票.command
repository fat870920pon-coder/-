#!/usr/bin/env bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

echo "================================================================="
echo "   月宮 (月下餐飲) ➔ 文中會計系統傳票一鍵產生工具"
echo "================================================================="
echo ""

./run.sh --store 月宮 "$@"

echo ""
read -p "請按 Enter 鍵關閉此視窗..."

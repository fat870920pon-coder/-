#!/bin/bash
cd "$(dirname "$0")"

echo "================================================================="
echo "🧾 啟動【手續費發票智慧辨識與文中傳票產生器】"
echo "================================================================="
echo ""
echo "📁 發票放置目錄：invoices/"
echo "   您可以將 Uber Eats、LINE Pay 等手續費電子發票（PDF、Excel 或文字檔）"
echo "   直接拖入 invoices/ 資料夾中。"
echo ""

./venv/bin/python3 process_invoices.py

echo ""
echo "================================================================="
echo "💡 提示：若產出無誤，已處理的檔案會自動為您備份至 invoices/processed/"
echo "================================================================="
read -p "請按 Enter 鍵關閉視窗..."

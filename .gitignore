# Google Service Account Credentials (DO NOT COMMIT)
credentials.json
*.json.secret
*.pem
*.key

# Python Virtual Environment & Cache
venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# System & OS Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Raw Invoices Folder
invoices/

# Allow HTML, JSON, and Excel Reports in output/ and docs/ for Web Dashboard Download
!index.html
!docs/index.html
!output/*.html
!output/*.xlsx
!docs/output/*.xlsx
!dashboard_data.json
!docs/dashboard_data.json
!output/dashboard_data.json

# Google Service Account Credentials (DO NOT COMMIT)
credentials.json
*.json.secret
*.pem
*.key
*session*.json
foodpanda_suiyi_session.json

# Python Virtual Environment & Cache
venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# System & OS Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Raw Invoices Folder (exclude raw, allow official statement PDFs/XLSX)
invoices/

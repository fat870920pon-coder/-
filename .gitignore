# Allow HTML, JSON, and Excel Reports in output/ and docs/ for Web Dashboard Download
!index.html
!docs/index.html
!output/*.html
!output/*.xlsx
!docs/output/*.xlsx
!dashboard_data.json
!docs/dashboard_data.json
!output/dashboard_data.json
